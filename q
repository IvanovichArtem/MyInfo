    "\n",
    "try:\n",
    "    from IPython.display import display\n",
    "except ModuleNotFoundError:\n",
    "    display = print\n",
    "\n",
    "VALID_MONTHS = 3\n",
    "LIMIT_BYN = 30_000_000\n",
    "MAX_RUN_DAYS = 7\n",
    "MILLION = 1_000_000\n",
    "SHORT_LEADS = (1, 7, 14, 30)\n",
    "BUCKETS = ((1, 7), (8, 14), (15, 30), (31, 90), (91, 180), (181, 366))\n",
    "DAY_NAMES = [\"Пн\", \"Вт\", \"Ср\", \"Чт\", \"Пт\", \"Сб\", \"Вс\"]"
