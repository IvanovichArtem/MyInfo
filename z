    "                ok = ~np.isnan(ytr)\n",
    "                if ok.sum() < 200:              # мало истории для длинного бакета\n",
    "                    models[k] = None\n",
    "                    continue\n",
    "                m = HistGradientBoostingRegressor(loss=\"quantile\", quantile=Q_LEVEL, max_iter=200,\n",
    "                                                  learning_rate=0.05, max_leaf_nodes=15,\n",
    "                                                  min_samples_leaf=40, random_state=0)\n",
    "                Xtr = X.values[:n_tr][ok]\n",
