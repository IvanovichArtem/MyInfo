df = pd.concat([pd.read_csv(f, sep=";", dtype=str) for f in sorted(Path("./data").glob("*.csv"))],
               ignore_index=True)

df = df[df["ISO_4217_CURY_DESC"].str.strip() == "BYN"]

df["REP_DT"] = pd.to_datetime(df["REP_DT"], format="%d.%m.%Y")
df["OST_VAL"] = pd.to_numeric(df["OST_VAL"].str.replace(" ", "").str.replace(",", "."))

daily = (df.groupby(["REP_DT", "GROU4_OF_COA"], as_index=False)["OST_VAL"].sum()
           .sort_values(["GROU4_OF_COA", "REP_DT"])
           .reset_index(drop=True))

print(daily.shape)
print(daily["GROU4_OF_COA"].unique())
