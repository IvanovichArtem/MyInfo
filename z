    "def make_features(s):\n",
    "    f = pd.DataFrame(index=s.index)\n",
    "    la = np.log(s)\n",
    "    for h in (5, 20, 60):\n",
    "        f[f\"ratio_ma{h}\"] = s / s.rolling(h).mean() - 1\n",
    "        f[f\"ret_{h}\"] = la.diff(h)\n",
    "    f[\"vol_20\"] = la.diff().rolling(20).std()\n",
    "    f[\"vol_60\"] = la.diff().rolling(60).std()\n",
    "    f[\"from_max60\"] = s / s.rolling(60).max() - 1\n",
    "    f[\"dom\"] = s.index.day\n",
    "    f[\"days_to_eom\"] = s.index.days_in_month - s.index.day\n",
    "    f[\"month\"] = s.index.month\n",
    "    f[\"yoy\"] = la.diff(365)\n",
    "    return f\n",
    "\n",
    "X = make_features(s)\n",
    "Q_LEVEL = 0.10          # базовый квантиль; итоговый уровень довыставит конформная поправка\n",
    "REFIT_MONTHS = 6\n",
    "\n",
    "def predict_gbm():\n",
    "    rows, models = {}, {}\n",
    "    for j, t0 in enumerate(forecast_dates):\n",
    "        i0 = POS[t0]\n",
