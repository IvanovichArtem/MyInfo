    "def load_real(path, coa_codes=None, currency=\"BYN\", value_col=\"OST_VAL\", sep=\";\", decimal=\",\"):\n",
    "    \"\"\"Агрегирует выгрузку в дневной ряд остатка сегмента (млн).\"\"\"\n",
    "    df = pd.read_csv(path, sep=sep, decimal=decimal)\n",
    "    df[\"REP_DT\"] = pd.to_datetime(df[\"REP_DT\"], dayfirst=True)\n",
    "    if coa_codes is not None:\n",
    "        df = df[df[\"GROU4_OF_COA\"].astype(str).isin([str(c) for c in coa_codes])]\n",
    "    df = df[df[\"ISO_4217_CURY_DESC\"] == currency]\n",
    "    s = df.groupby(\"REP_DT\")[value_col].sum() / 1e6\n",
    "    return s.asfreq(\"D\").ffill().rename(\"amount\")      # выходные — последним известным остатком\n",
    "\n",
    "\n",
    "def make_synthetic(start=\"2018-01-01\", end=\"2025-06-30\", level0=2500.0, seed=7):\n",
    "    rng = np.random.default_rng(seed)\n",
    "    idx = pd.date_range(start, end, freq=\"D\")\n",
    "    n = len(idx)\n",
    "    years = np.arange(n) / 365.25\n",
    "    regime_break = idx > DEV_END\n",
    "\n",
    "    # тренд: 9%/год до августа 2023, затем 2%/год\n",
    "    growth = np.where(regime_break, 0.02, 0.09) / 365.25\n",
    "    trend = np.cumsum(growth)\n",
    "\n",
    "    annual = 0.025 * np.sin(2 * np.pi * (idx.dayofyear.values - 100) / 365.25)\n",
    "\n",
    "    # зарплатный цикл: скачок 5-го (0.08) и 20-го (0.05), затем экспоненциальное «проедание»\n",
    "    dom = idx.day.values\n",
    "    dim_prev = (idx - pd.offsets.MonthBegin(1)).days_in_month.values\n",
    "    since = np.where(dom >= 20, dom - 20, np.where(dom >= 5, dom - 5, dom + dim_prev - 20))\n",
    "    amp = np.where((dom >= 5) & (dom < 20), 0.08, 0.05)\n",
    "    cycle = amp * np.exp(-since / 7.0)\n",
    "\n",
    "    # AR(1)-шум, после разрыва режима волатильнее\n",
    "    sig = np.where(regime_break, 0.009, 0.005)\n",
    "    eps = rng.normal(0, 1, n) * sig\n",
    "    ar = np.zeros(n)\n",
    "    for i in range(1, n):\n",
    "        ar[i] = 0.97 * ar[i - 1] + eps[i]\n",
    "\n",
    "    # случайные крупные списания: −2…−6%, восстанавливаются ~40 дней\n",
    "    lumps = np.zeros(n)\n",
    "    for i0 in np.where(rng.random(n) < (np.where(regime_break, 1/60, 1/120)))[0]:\n",
    "        d = rng.uniform(0.02, 0.06)\n",
    "        k = np.arange(n - i0)\n",
    "        lumps[i0:] -= d * np.exp(-k / 40.0)\n",
    "\n",
    "    def shock(t0, depth, fall, rec):\n",
    "        out = np.zeros(n)\n",
    "        i0 = idx.get_indexer([pd.Timestamp(t0)])[0]\n",
    "        k = np.arange(n - i0)\n",
    "        out[i0:] = np.where(k <= fall, -depth * k / fall, -depth * np.exp(-(k - fall) / rec))\n",
    "        return out\n",
    "\n",
    "    shocks = shock(\"2020-03-16\", 0.06, 20, 90) + shock(\"2022-02-24\", 0.18, 14, 240)\n",
    "\n",
    "    log_amount = np.log(level0) + trend + annual + cycle + ar + lumps + shocks\n",
    "    amount = pd.Series(np.exp(log_amount), index=idx, name=\"amount\")\n",
    "\n",
    "    raw = pd.DataFrame({\"REP_DT\": idx.strftime(\"%d.%m.%Y\"), \"GROU4_OF_COA\": \"3014\",\n",
    "                        \"ISO_4217_CURY_DESC\": \"BYN\", \"CURRENCY\": 1.0,\n",
    "                        \"OST_VAL\": amount.values * 1e6})\n",
    "    raw[\"OST_NV\"] = raw[\"OST_VAL\"] * raw[\"CURRENCY\"]\n",
    "    return amount, raw\n",
    "\n",
    "\n",
    "if USE_SYNTHETIC:\n",
    "    s, raw = make_synthetic()\n",
    "else:\n",
