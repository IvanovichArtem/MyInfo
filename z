    "def oos_backtest(K):\n",
    "    \"\"\"Прогнозы вне выборки для всех моделей: {модель: DataFrame квантилей по точкам прогноза}.\"\"\"\n",
    "    tg = K[\"tgt_date\"].sort_values()\n",
    "    if len(tg) <= MIN_TRAIN_STAT:\n",
    "        return None, None\n",
    "    start = max(tg.iloc[MIN_TRAIN_STAT], K.index.min())\n",
    "    end = K.index.max() + pd.Timedelta(days=1)\n",
    "    span = (end - start).days\n",
    "    if span < MIN_EVAL_DAYS:\n",
    "        return None, None\n",
    "    step = max(CV_STEP_DAYS, int(np.ceil(span / MAX_FOLDS)))\n",
    "    cuts, c = [], end - pd.Timedelta(days=step)\n",
    "    while c >= start:\n",
    "        cuts.append(c); c -= pd.Timedelta(days=step)\n",
    "    cuts = sorted(cuts) or [start]\n",
    "    res = {}\n",
    "    for c in cuts:\n",
    "        train = K[K[\"tgt_date\"] < c]\n",
    "        blk = K[(K.index >= c) & (K.index < c + pd.Timedelta(days=step))]\n",
    "        if len(blk) == 0 or len(train) < MIN_TRAIN_STAT:\n",
    "            continue\n",
    "        for n, P in fit_predict(train, blk).items():\n",
    "            res.setdefault(n, []).append(pd.DataFrame(P, index=blk.index, columns=QCOLS))\n",
    "    return {n: pd.concat(v).sort_index() for n, v in res.items()}, step\n",
    "\n",
    "\n",
    "def mae_level(D, Q, tr):\n",
    "    pred = tr.to_level(D[\"b0\"], Q[\"q0.5\"], D[\"sc\"])\n",
    "    return float(np.mean(np.abs(D[\"bh\"].to_numpy() - pred)))\n",
    "\n",
    "\n",
    "def coverage(D, Q):\n",
    "    return (D[\"y\"].to_numpy()[:, None] <= Q.to_numpy()).mean(axis=0)\n",
    "\n",
    "\n",
    "def calib_shifts(D, Q):\n",
    "    \"\"\"Конформная поправка: сдвиг каждого квантиля, чтобы доля фактов ниже него = q.\"\"\"\n",
    "    res = D[\"y\"].to_numpy()[:, None] - Q.to_numpy()\n",
    "    sh = np.array([np.quantile(res[:, i], q) for i, q in enumerate(QUANTILES)])\n",
    "    if not CALIBRATE_MEDIAN:\n",
    "        sh[QI_MED] = 0.0\n",
    "    return sh\n",
    "\n",
    "\n",
    "def apply_shifts(P, sh):\n",
    "    return np.sort(np.asarray(P) + sh, axis=1)\n",
    "\n",
    "\n",
    "def select_model(K, oos, mask_fn, tr):\n",
    "    \"\"\"Сравнение моделей на одинаковых точках; сложная модель должна обогнать naive на SELECTION_MARGIN.\"\"\"\n",
    "    cand = {n: q[mask_fn(q.index)] for n, q in oos.items()}\n",
    "    cand = {n: q for n, q in cand.items() if len(q) >= MIN_EVAL_POINTS}\n",
    "    if \"naive\" not in cand:\n",
    "        return None, {}\n",
    "    common = None\n",
    "    for q in cand.values():\n",
    "        common = q.index if common is None else common.intersection(q.index)\n",
    "    if len(common) < MIN_EVAL_POINTS:          # бустинг появился поздно — сравниваем без него\n",
    "        cand = {n: q for n, q in cand.items() if len(q) == len(cand[\"naive\"])}\n",
    "        common = cand[\"naive\"].index\n",
    "    D = K.loc[common]\n",
    "    maes = {n: mae_level(D, q.loc[common], tr) for n, q in cand.items()}\n",
    "    best = min(maes, key=maes.get)\n",
    "    if best != \"naive\" and maes[best] > maes[\"naive\"] * (1 - SELECTION_MARGIN):\n",
    "        best = \"naive\"\n",
    "    return best, maes"
   ]
