    "def drawdown_targets(s):\n",
    "    a = s.values\n",
    "    out = {}\n",
    "    for k, tau in TAU.items():\n",
    "        fwd_min = pd.Series(a[::-1]).rolling(tau + 1,\n",
    "                                             min_periods=tau + 1).min().values[::-1]\n",
    "        out[k] = fwd_min / a - 1\n",
    "    return pd.DataFrame(out, index=s.index)\n",
    "\n",
    "\n",
    "dd = drawdown_targets(s)\n",
    "forecast_dates = pd.date_range(\n",
    "    FIRST_FORECAST, s.index[-1] - pd.Timedelta(days=1), freq=\"MS\")\n",
    "POS = {t: s.index.get_loc(t) for t in forecast_dates}\n",
