import matplotlib.pyplot as plt

fig, ax = plt.subplots(3, 1, figsize=(14, 10))

ax[0].plot(s, lw=0.8)
ax[0].set_title("Остаток ФЛ BYN, млн")

last = s.last("120D")
ax[1].plot(last, lw=1.2, marker=".")
ax[1].set_title("Последние 120 дней")

# средний профиль по дню месяца: отклонение от среднего за месяц, %
dev = (s / s.groupby(s.index.to_period("M")).transform("mean") - 1) * 100
dev.groupby(dev.index.day).mean().plot.bar(ax=ax[2])
ax[2].set_title("Средний профиль внутри месяца: отклонение от среднего за месяц, %")
ax[2].set_xlabel("день месяца")

plt.tight_layout(); plt.show()
