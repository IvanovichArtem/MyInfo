    "def kernel_weights(h, kind):\n",
    "    u = -np.arange(h) / h                       # 0 = сегодня, −(h−1)/h = самый старый день окна\n",
    "    if kind == \"Truncated\":\n",
    "        w = np.ones(h)\n",
    "    elif kind == \"Epanechnikov\":\n",
    "        w = 1 - u ** 2\n",
    "    elif kind == \"Gaussian\":\n",
    "        w = np.exp(-0.5 * u ** 2)\n",
    "    else:\n",
    "        raise ValueError(kind)\n",
    "    w = w[::-1]                                 # для rolling: от старых к новым\n",
    "    return w / w.sum()\n",
    "\n",
    "_regime_cache = {}\n",
    "def regime(h, kind):\n",
    "    \"\"\"True = high. Первые h−1 дней — NaN-уровень → считаем low.\"\"\"\n",
    "    key = (h, kind)\n",
    "    if key not in _regime_cache:\n",
    "        w = kernel_weights(h, kind)\n",
    "        level = np.convolve(s.values, w[::-1], mode=\"full\")[: len(s)]\n",
    "        level[: h - 1] = np.nan\n",
    "        _regime_cache[key] = s.values >= np.nan_to_num(level, nan=np.inf)\n",
    "    return _regime_cache[key]\n",
    "\n",
    "\n",
    "def monotone(a):\n",
    "    \"\"\"a: DataFrame (даты × бакеты) сырых накопленных долей → монотонный накопленный отток.\"\"\"\n",
    "    return pd.DataFrame(np.minimum.accumulate(np.minimum(a.values, 0), axis=1),\n",
    "                        index=a.index, columns=a.columns)\n",
    "\n",
    "\n",
    "P_GRID = np.arange(50, 100, 1)\n",
    "H_GRID = [3, 5, 10, 15, 20, 25, 30, 40]\n",
    "K_GRID = [\"Truncated\", \"Epanechnikov\", \"Gaussian\"]\n",
    "\n",
    "def old_pool_quantiles(k, h, kind, i0, p_levels, use_regime=True):\n",
    "    tau = TAU[k]\n",
    "    hist = dd[k].values[: max(i0 - tau + 1, 0)]\n",
    "    if use_regime:\n",
    "        reg = regime(h, kind)\n",
    "        hist = hist[reg[: len(hist)] == reg[i0]]\n",
    "    hist = hist[~np.isnan(hist)]\n",
    "    if len(hist) < 20:\n",
    "        return np.full(len(p_levels), np.nan)\n",
    "    return np.quantile(hist, 1 - np.asarray(p_levels) / 100)    # p-квантиль размера оттока\n",
    "\n",
    "\n",
    "def calibrate_old_by_mae(use_regime=True):\n",
    "    \"\"\"Перебор сетки на dev: прогнозы на начало месяца, исход должен быть известен до DEV_END.\"\"\"\n",
    "    best = {}\n",
    "    for k in BUCKETS:\n",
    "        dates = [t for t in forecast_dates if t + pd.Timedelta(days=TAU[k]) <= DEV_END]\n",
