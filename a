    "calc_obj = C.Calc(df)\n",
    "amount = df.loc[df.date == REPORT_DT, \"amount\"].iloc[0]\n",
    "year_hist = df.loc[df.date.between(REPORT_DT - pd.DateOffset(years=1), REPORT_DT), \"amount\"]\n",
    "stable = year_hist.min() * beta\n",
    "variable = amount - stable\n",
    "\n",
    "win = df[df.date.between(REPORT_DT - pd.Timedelta(days=BW), REPORT_DT)]\n",
    "X = (win.date - REPORT_DT).dt.days.to_numpy(float)\n",
    "w = 0.75 * (1 - (X / BW) ** 2)\n",
    "y_hat = (w * win.amount).sum() / w.sum()\n",
    "is_low = calc_obj.low(REPORT_DT, BW)\n",
    "a = np.array(a_low if is_low else a_high)\n",
    "\n",
    "print(f\"Сегодня ({REPORT_DT.date()}): остаток {amount:,.1f} млн\")\n",
    "print(f\"Минимум за год ({len(year_hist)} дней): {year_hist.min():,.1f} → Stable = {beta} × {year_hist.min():,.1f} = {stable:,.1f}\")\n",
    "print(f\"Variable = {amount:,.1f} − {stable:,.1f} = {variable:,.1f}  ({variable / amount:.1%} остатка)\")\n",
    "print(f\"Обычный уровень за 30 дней = {y_hat:,.1f}; сегодня {amount:,.1f} → режим {'LOW' if is_low else 'HIGH'} \"\n",
    "      f\"(разница {amount - y_hat:+,.1f} млн)\")\n",
    "\n",
    "steps = []\n",
    "deepest = 0.0\n",
    "for i, b in enumerate(BUCKETS):\n",
    "    inc = a[0] if i == 0 else min(a[i] - min(a[:i]), 0.0)\n",
    "    steps.append({\"бакет\": b, \"a (накопл.)\": a[i], \"уже заложено\": deepest if i else 0.0,\n",
