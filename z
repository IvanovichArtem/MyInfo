    "show = [\"group\", \"horizon_m\", \"status\", \"model_for_test\", \"model\", \"n_oos\", \"n_test\",\n",
    "        \"skill_backtest\", \"MAE_naive_test\", \"MAE_model_test\", \"skill_test\", \"WAPE_test\"] + [f\"cov_{c}\" for c in QCOLS]\n",
    "show = [c for c in show if c in results.columns]\n",
    "show_df(results[show], {\n",
    "    \"MAE_naive_test\": \"{:,.0f}\", \"MAE_model_test\": \"{:,.0f}\", \"skill_test\": \"{:+.1%}\", \"skill_backtest\": \"{:+.1%}\",\n",
    "    \"WAPE_test\": \"{:.2%}\", **{f\"cov_{c}\": \"{:.2f}\" for c in QCOLS}})\n",
    "\n",
    "mae_cols = [c for c in results.columns if c.startswith(\"MAE_bt_\")]\n",
    "for name in list(SERIES)[:PLOT_GROUPS_MAX]:\n",
