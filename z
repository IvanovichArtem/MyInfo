    "METHODS = {\n",
    "    \"M0 старая\": monotone(raw_m0),\n",
    "    \"M0b без режимов\": monotone(raw_m0b),\n",
    "    \"M1 старая+конформ\": monotone(raw_m1),\n",
    "    \"M2 бустинг+конформ\": monotone(raw_m2),\n",
    "    \"M3 аналоги+конформ\": monotone(raw_m3),\n",
    "}\n",
    "\n",
    "def period_of(t):\n",
    "    return \"dev\" if t <= DEV_END else \"OOT\"\n",
    "\n",
    "def bucket_metrics(c):\n",
    "    rows = []\n",
    "    for k in BUCKETS:\n",
    "        for t0 in c.index:\n",
    "            if t0 + pd.Timedelta(days=TAU[k]) > s.index[-1] or np.isnan(c.loc[t0, k]):\n",
    "                continue\n",
    "            A0 = s.loc[t0]\n",
    "            err = (dd.loc[t0, k] - c.loc[t0, k]) * A0      # < 0 — факт ниже прогноза (опасно)\n",
    "            rows.append((period_of(t0), k, err))\n",
    "    m = pd.DataFrame(rows, columns=[\"period\", \"bucket\", \"err\"])\n",
    "    return m.groupby([\"period\", \"bucket\"]).agg(\n",
    "        MAE=(\"err\", lambda e: e.abs().mean()),\n",
    "        bias=(\"err\", \"mean\"),\n",
    "        breach_rate=(\"err\", lambda e: (e < -THR).mean()),\n",
    "        n=(\"err\", \"size\"))\n",
    "\n",
    "def day_level(c):\n",
    "    \"\"\"Для прогнозов с полностью известными 12M: сколько дней факт был ниже «пола» прогноза − THR.\"\"\"\n",
    "    rows = []\n",
    "    for t0 in c.index:\n",
    "        end = t0 + pd.Timedelta(days=TAU[12])\n",
    "        if end > s.index[-1] or c.loc[t0].isna().any():\n",
    "            continue\n",
    "        A0 = s.loc[t0]\n",
    "        path = s[t0 + pd.Timedelta(days=1): end]\n",
    "        days = (path.index - t0).days.values\n",
    "        b = np.searchsorted(TAU_ARR, days, side=\"left\")\n",
    "        floor = A0 * (1 + c.loc[t0].values[b])\n",
    "        breach_days = int(((path.values - floor) < -THR).sum())\n",
    "        rows.append((period_of(t0), breach_days, 1 + c.loc[t0, 12]))\n",
    "    return pd.DataFrame(rows, columns=[\"period\", \"breach_days\", \"stable_12M\"])\n",
    "\n",
    "summary, per_bucket = [], {}\n",
    "for name, c in METHODS.items():\n",
    "    bm = bucket_metrics(c); per_bucket[name] = bm\n",
    "    dl = day_level(c)\n",
    "    for per in [\"dev\", \"OOT\"]:\n",
    "        b = bm.loc[per] if per in bm.index.get_level_values(0) else None\n",
    "        d = dl[dl.period == per]\n",
    "        summary.append({\n",
    "            \"метод\": name, \"период\": per,\n",
    "            \"MAE ср., млн\": b[\"MAE\"].mean() if b is not None else np.nan,\n",
    "            \"bias ср., млн\": b[\"bias\"].mean() if b is not None else np.nan,\n",
    "            \"breach_rate ср.\": b[\"breach_rate\"].mean() if b is not None else np.nan,\n",
    "            \"fail_7d (доля прогнозов >7 дн.)\": (d.breach_days > MAX_BREACH_DAYS).mean() if len(d) else np.nan,\n",
    "            \"дней пробоя ср.\": d.breach_days.mean() if len(d) else np.nan,\n",
    "            \"stable_12M\": d.stable_12M.mean() if len(d) else np.nan,\n",
    "            \"N прогнозов 12M\": len(d)})\n",
    "\n",
    "summary = pd.DataFrame(summary).set_index([\"период\", \"метод\"]).sort_index()\n",
    "display(summary.round(3))"
