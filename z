    "def _band(lo, hi):\n",
    "    return (f\"q{lo:g}\" in QCOLS and f\"q{hi:g}\" in QCOLS)\n",
    "\n",
    "if len(backtest):\n",
    "    for name in list(SERIES)[:PLOT_GROUPS_MAX]:\n",
    "        b = backtest[backtest[\"group\"] == name]\n",
    "        hs = [h for h in (1, 3, 6, 12) if h in set(b[\"horizon_m\"])]\n",
    "        if not hs:\n",
    "            continue\n",
    "        fig, axes = plt.subplots(1, len(hs), figsize=(4.5 * len(hs), 3.5), squeeze=False)\n",
    "        for ax, h in zip(axes[0], hs):\n",
    "            bb = b[b[\"horizon_m\"] == h].sort_values(\"tgt_date\")\n",
    "            if _band(0.05, 0.95):\n",
    "                ax.fill_between(bb[\"tgt_date\"], bb[\"q0.05\"], bb[\"q0.95\"], alpha=.2, label=\"5–95%\")\n",
    "            ax.plot(bb[\"tgt_date\"], bb[\"bh\"], \"k\", lw=1, label=\"факт\")\n",
    "            ax.plot(bb[\"tgt_date\"], bb[\"q0.5\"], \"C1\", lw=1, label=\"медиана\")\n",
    "            if bb[\"is_test\"].any():\n",
    "                ax.axvline(bb.loc[bb[\"is_test\"], \"tgt_date\"].min(), color=\"grey\", ls=\"--\", lw=1)\n",
    "            ax.set_title(f\"{name}: {h}M\"); ax.tick_params(axis=\"x\", rotation=30); ax.grid(alpha=.3)\n",
    "        axes[0][0].legend(); plt.tight_layout(); plt.show()"
