BUCKETS = list(range(1, 13))
TAU = {k: int(round(30.4 * k)) for k in BUCKETS}          # правая граница бакета в днях

def max_outflow(s, tau):
    """Шаг 3–4: (min(A_t..A_t+tau) - A_t) / A_t. NaN, если будущее ещё не наступило."""
    fwd_min = s[::-1].rolling(tau + 1, min_periods=tau + 1).min()[::-1]
    return fwd_min / s - 1

