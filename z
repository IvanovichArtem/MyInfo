DEV_END = pd.Timestamp("2023-07-31")
THR = 100                                   # порог бизнеса, млн (уточнить: 50 или 100)

start = s.index.min() + pd.DateOffset(years=1)          # нужен хотя бы год истории
forecast_dates = pd.date_range(start, s.index.max(), freq="MS")

raw_a = pd.DataFrame({t0: forecast_a(t0)["a"].values for t0 in forecast_dates},
                     index=BUCKETS).T
c = pd.DataFrame(np.minimum.accumulate(np.minimum(raw_a.values, 0), axis=1),
                 index=raw_a.index, columns=BUCKETS)        # монотонный накопленный отток

print(f"Прогнозов: {len(c)},  {c.index.min().date()} — {c.index.max().date()}")

rows = []
for k in BUCKETS:
    for t0 in c.index:
        actual = dd.loc[t0, k]
        if np.isnan(actual) or np.isnan(c.loc[t0, k]):
            continue                                       # будущее ещё не наступило
        err = (actual - c.loc[t0, k]) * s.loc[t0]          # < 0: факт ниже прогноза (опасно)
        rows.append({"период": "dev" if t0 <= DEV_END else "OOT", "бакет": k, "err": err})
errs = pd.DataFrame(rows)

metrics = (errs.groupby(["период", "бакет"])["err"]
               .agg(N="size",
                    MAE=lambda e: e.abs().mean(),
                    bias="mean",
                    breach=lambda e: (e < -THR).mean())
               .round(2)
               .unstack("период"))
metrics

errs["год"] = [t.year for t in c.index.repeat(1)][:0] or None   # заглушка, перезапишем ниже
errs = errs.drop(columns="год")

rows = []
for k in BUCKETS:
    for t0 in c.index:
        actual = dd.loc[t0, k]
        if np.isnan(actual):
            continue
        rows.append({"год": t0.year, "бакет": f"{k}M",
                     "breach": (actual - c.loc[t0, k]) * s.loc[t0] < -THR})
by_year = (pd.DataFrame(rows)
             .pivot_table(index="год", columns="бакет", values="breach", aggfunc="mean")
             [[f"{k}M" for k in BUCKETS]])

fig, ax = plt.subplots(figsize=(13, 0.5 * len(by_year) + 1))
im = ax.imshow(by_year.values, cmap="Reds", vmin=0, vmax=0.6, aspect="auto")
ax.set_xticks(range(12), by_year.columns); ax.set_yticks(range(len(by_year)), by_year.index)
for (i, j), v in np.ndenumerate(by_year.values):
    if not np.isnan(v):
        ax.text(j, i, f"{v:.2f}", ha="center", va="center", fontsize=8)
ax.set_title(f"Доля прогнозов с пробоем > {THR} млн"); plt.colorbar(im); plt.show()
