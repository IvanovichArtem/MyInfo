    "THR = 100\n",
    "rows = []\n",
    "A_ser = df.set_index(\"date\")[\"amount\"]\n",
    "FIRST_FC = df.date.min() + pd.DateOffset(years=2, months=1)       # коду нужно > 2 лет истории\n",
    "for t0 in pd.date_range(FIRST_FC, REPORT_DT, freq=\"MS\"):\n",
    "    try:\n",
    "        with contextlib.redirect_stdout(io.StringIO()):\n",
    "            res = M.calibrate(df, t0, bw=BW, percentile=PCT)\n",
    "            out = M.build_model_gap(df, t0, t0, bw=BW, percentile=PCT).values.ravel()\n",
    "    except ValueError as err:\n",
    "        print(f\"{t0.date()}: код разработчика отказался считать — {err}\")\n",
    "        continue\n",
    "    a0 = A_ser[t0]\n",
    "    st0 = A_ser[t0 - pd.DateOffset(years=1):t0].min() * res[\"beta\"]\n",
    "    f1y = A_ser[t0:t0 + pd.Timedelta(days=365)]\n",
    "    f1m = A_ser[t0:t0 + pd.Timedelta(days=30)]\n",
    "    full_year = t0 + pd.Timedelta(days=365) <= REPORT_DT\n",
    "    rows.append({\"дата\": t0.date(), \"остаток\": a0, \"β\": res[\"beta\"], \"Stable\": st0,\n",
    "                 \"Stable, %\": st0 / a0, \"режим\": \"low\" if C.Calc(df).low(t0, BW) else \"high\",\n",
    "                 \"отток 1M прогноз\": out[0], \"мин. факт 1M\": f1m.min() if t0 + pd.Timedelta(days=30) <= REPORT_DT else np.nan,\n",
    "                 \"пробой 1M\": (f1m.min() < a0 + out[0] - THR) if t0 + pd.Timedelta(days=30) <= REPORT_DT else np.nan,\n",
    "                 \"мин. факт за год\": f1y.min() if full_year else np.nan,\n",
    "                 \"пробой Stable\": (f1y.min() < st0) if full_year else np.nan})\n",
    "hist_fc = pd.DataFrame(rows)\n",
    "display(hist_fc.round(3).iloc[::6])      # каждые полгода, полная таблица — в файле\n",
    "save(hist_fc, \"08_monthly_forecasts\", index=False)\n",
    "\n",
    "by_year = (hist_fc.assign(год=pd.to_datetime(hist_fc[\"дата\"]).dt.year)\n",
