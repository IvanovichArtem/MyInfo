    "model = calibration(hist)\n",
    "beta = model.stable()                                   # β — функцией разработчика\n",
    "\n",
    "st = hist[[\"date\", \"amount\"]].copy()                    # те же формулы, чтобы показать внутренности\n",
    "st[\"min_past\"] = st[\"amount\"].rolling(365, min_periods=100).min()\n",
    "st[\"min_future\"] = st[\"amount\"].iloc[::-1].rolling(365, min_periods=100).min().iloc[::-1]\n",
    "st[\"ratio\"] = st[\"min_future\"] / st[\"min_past\"]\n",
    "worst = st.loc[st[\"ratio\"].idxmin()]\n",
    "\n",
    "print(f\"β = {beta}\")\n",
    "print(f\"Худший день: {worst.date.date()}. Минимум прошлого года {worst.min_past:,.0f} млн, \"\n",
