    "                               **{\"пробоев Stable\": (\"пробой Stable\", lambda x: int(x.dropna().astype(bool).sum()))}))\n",
    "print(\"По годам:\"); display(by_year.round(3)); save(by_year, \"08_by_year\")\n",
    "\n",
    "b1 = hist_fc[\"пробой 1M\"].dropna().astype(bool); bs = hist_fc[\"пробой Stable\"].dropna().astype(bool)\n",
