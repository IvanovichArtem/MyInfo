   "source": [
    "## 6. Прогон по горизонтам"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "def run_horizon(s, F, tr, m, origins):\n",
    "    D = build_dataset(s, F, tr, m, origins)\n",
    "    last_date = s.index.max()\n",
    "    K = D[D[\"tgt_date\"] <= last_date].dropna(subset=[\"y\"])\n",
    "    x_last = D.loc[[last_date]]\n",
    "    out = {\"horizon_m\": m, \"target_date\": (last_date + pd.DateOffset(months=m)).date(), \"n_known\": len(K)}\n",
    "\n",
    "    oos, step = oos_backtest(K) if len(K) > MIN_TRAIN_STAT else (None, None)\n",
    "    if oos is None or \"naive\" not in oos or len(oos[\"naive\"]) < MIN_EVAL_POINTS:\n",
    "        # Мало данных: без бэктеста — «остаток не изменится» + разброс из истории\n",
    "        if len(K) >= MIN_TRAIN_STAT:\n",
    "            out[\"status\"], out[\"model\"] = \"no_backtest\", \"naive\"\n",
    "            P = NaiveModel().fit(K).predict(x_last)\n",
    "        else:\n",
    "            out[\"status\"], out[\"model\"] = \"short_history\", \"random_walk\"\n",
    "            P = RandomWalkModel(s, tr, m).predict(x_last)\n",
    "        return out, tr.to_level(x_last[\"b0\"], P, x_last[\"sc\"])[0], None\n",
    "\n",
    "    # --- тестовое окно: последние TEST_DAYS точек прогноза (не больше трети бэктеста)\n",
    "    oos_start = oos[\"naive\"].index.min()\n",
    "    test_days = min(TEST_DAYS, max(MIN_EVAL_DAYS, (K.index.max() - oos_start).days // 3))\n",
    "    T0 = K.index.max() - pd.Timedelta(days=test_days)\n",
    "    tgt = K[\"tgt_date\"]\n",
    "    known_before_test = lambda idx: (tgt.loc[idx] <= T0).to_numpy()\n",
    "    in_test = lambda idx: (idx > T0)\n",
    "\n",
    "    # --- 1) честный тест: выбор и калибровка только по тому, что было известно к T0\n",
    "    m_test, maes_pre = select_model(K, oos, known_before_test, tr)\n",
    "    if m_test is None:\n",
    "        m_test = \"naive\"\n",
    "    pre_idx = oos[m_test].index[known_before_test(oos[m_test].index)]\n",
    "    sh_pre = calib_shifts(K.loc[pre_idx], oos[m_test].loc[pre_idx]) if len(pre_idx) >= MIN_EVAL_POINTS \\\n",
    "        else np.zeros(len(QUANTILES))\n",
    "    test_idx = oos[\"naive\"].index[in_test(oos[\"naive\"].index)]\n",
    "    Dt = K.loc[test_idx]\n",
    "    mae_test = {n: mae_level(Dt, q.loc[test_idx], tr) for n, q in oos.items() if test_idx.isin(q.index).all()}\n",
    "    Qt = pd.DataFrame(apply_shifts(oos[m_test].loc[test_idx], sh_pre), index=test_idx, columns=QCOLS)\n",
    "    cov = coverage(Dt, Qt)\n",
    "\n",
    "    # --- 2) финальная модель: по всему бэктесту; калибровка по всем прогнозам вне выборки\n",
    "    final, maes_all = select_model(K, oos, lambda idx: np.ones(len(idx), bool), tr)\n",
    "    final = final or \"naive\"\n",
    "    sh_all = calib_shifts(K.loc[oos[final].index], oos[final])\n",
    "    P = apply_shifts(fit_predict(K, x_last, only=final), sh_all)\n",
    "    fc = tr.to_level(x_last[\"b0\"], P, x_last[\"sc\"])[0]\n",
    "\n",
    "    mean_act = float(Dt[\"bh\"].abs().mean())\n",
    "    out.update({\n",
    "        \"status\": \"full\" if \"gbm\" in oos else \"stat_only\",\n",
    "        \"n_oos\": len(oos[\"naive\"]), \"n_test\": len(test_idx), \"cv_step_days\": step,\n",
    "        \"model_for_test\": m_test, \"model\": final,\n",
    "        \"MAE_naive_test\": mae_test[\"naive\"], \"MAE_model_test\": mae_test.get(m_test, np.nan),\n",
    "        \"skill_test\": 1 - mae_test.get(m_test, np.nan) / mae_test[\"naive\"] if mae_test[\"naive\"] > 0 else np.nan,\n",
    "        \"skill_backtest\": 1 - maes_all[final] / maes_all[\"naive\"] if maes_all.get(\"naive\") else np.nan,\n",
    "        \"WAPE_test\": mae_test.get(m_test, np.nan) / mean_act if mean_act > 0 else np.nan,\n",
    "        **{f\"cov_{c}\": v for c, v in zip(QCOLS, cov)},\n",
    "        **{f\"MAE_bt_{n}\": v for n, v in maes_all.items()},\n",
    "    })\n",
    "    Qa = pd.DataFrame(apply_shifts(oos[final], sh_all), index=oos[final].index, columns=QCOLS)\n",
    "    bt = K.loc[Qa.index, [\"tgt_date\", \"bh\"]].copy()\n",
    "    bt[QCOLS] = tr.to_level(K.loc[Qa.index, \"b0\"], Qa.to_numpy(), K.loc[Qa.index, \"sc\"])\n",
    "    bt[\"horizon_m\"] = m\n",
    "    bt[\"is_test\"] = bt.index > T0\n",
    "    return out, fc, bt\n",
    "\n",
    "\n",
    "def run_series(g, name):\n",
    "    s, observed = prepare_series(g)\n",
    "    tr = Target(s)\n",
    "    F = make_features(s, tr)\n",
    "    origins = observed if ORIGINS_OBSERVED_ONLY else s.index\n",
    "    print(f\"[{name}] {s.index.min().date()} → {s.index.max().date()}, дней: {len(s)}, таргет: {tr.mode}\")\n",
    "    rows, fcs, bts = [], [], []\n",
    "    for m in HORIZONS_M:\n",
    "        t0 = time.time()\n",
    "        out, fc, bt = run_horizon(s, F, tr, m, origins)\n",
    "        out[\"group\"] = name\n",
    "        rows.append(out)\n",
    "        fcs.append({\"group\": name, \"horizon_m\": m, \"target_date\": out[\"target_date\"],\n",
    "                    \"last_amount\": float(s.iloc[-1]), \"model\": out[\"model\"], \"status\": out[\"status\"],\n",
    "                    **dict(zip(QCOLS, fc))})\n",
    "        if bt is not None:\n",
    "            bt[\"group\"] = name\n",
    "            bts.append(bt)\n",
    "        pct = lambda v: \"—\" if v is None or pd.isna(v) else f\"{v:+.1%}\"\n",
    "        print(f\"  {m:>2}M  {out['status']:<13} модель={out['model']:<11} \"\n",
    "              f\"skill бэктест={pct(out.get('skill_backtest'))}  тест={pct(out.get('skill_test'))}  \"\n",
    "              f\"({time.time() - t0:.1f}s)\")\n",
    "    return s, pd.DataFrame(rows), pd.DataFrame(fcs), (pd.concat(bts) if bts else None)\n",
    "\n",
    "\n",
    "groups = [(\"all\", df)] if not GROUP_COLS else [\n",
    "    (\" | \".join(map(str, k if isinstance(k, tuple) else (k,))), g) for k, g in df.groupby(GROUP_COLS)]\n",
    "\n",
    "SERIES, RESULTS, FORECASTS, BACKTESTS = {}, [], [], []\n",
    "for name, g in groups:\n",
    "    s, res, fc, bt = run_series(g, name)\n",
    "    SERIES[name] = s\n",
    "    RESULTS.append(res); FORECASTS.append(fc)\n",
    "    if bt is not None:\n",
    "        BACKTESTS.append(bt)\n",
    "\n",
    "results = pd.concat(RESULTS, ignore_index=True)\n",
    "forecast = pd.concat(FORECASTS, ignore_index=True)\n",
    "backtest = pd.concat(BACKTESTS, ignore_index=True) if BACKTESTS else pd.DataFrame()"
   ]
  },
