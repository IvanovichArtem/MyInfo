SHOW_HORIZON = 1        # горизонт в месяцах
SHOW_GROUP = None       # None = первая группа; иначе имя, например "RUB | ФЛ"

def show_test(horizon=SHOW_HORIZON, group=SHOW_GROUP):
    if test_preds.empty:
        print("Нет тестовых прогнозов: истории не хватило ни на один горизонт.")
        return
    group = group or test_preds["group"].iloc[0]
    tp = test_preds[(test_preds["group"] == group) & (test_preds["horizon_m"] == horizon)]
    if tp.empty:
        ok = sorted(test_preds.loc[test_preds["group"] == group, "horizon_m"].unique())
        print(f"Для [{group}] на {horizon}M теста нет (мало истории). Доступные горизонты: {ok}")
        return

    # --- таблица ошибок по моделям
    rows = []
    for n, f in tp.groupby("model"):
        err = f["bh"] - f["q0.5"]
        rows.append({"модель": n, "MAE": err.abs().mean(),
                     "MAE, % от остатка": err.abs().mean() / f["bh"].abs().mean(),
                     "смещение (факт − прогноз)": err.mean(),
                     "макс. ошибка": err.abs().max(),
                     "покрытие 5–95%": ((f["bh"] >= f["q0.05"]) & (f["bh"] <= f["q0.95"])).mean()
                                        if _band(0.05, 0.95) else np.nan})
    tab = pd.DataFrame(rows).sort_values("MAE").reset_index(drop=True)
    mae_naive = tab.loc[tab["модель"] == "naive", "MAE"].iloc[0]
    tab["лучше naive"] = 1 - tab["MAE"] / mae_naive
    best = tab.iloc[0]

    # --- вывод словами
    r = results[(results["group"] == group) & (results["horizon_m"] == horizon)].iloc[0]
    f0 = tp[tp["model"] == best["модель"]]
    print(f"[{group}] горизонт {horizon}M, тест: {f0['tgt_date'].min().date()} → {f0['tgt_date'].max().date()}, "
          f"точек: {len(f0)}")
    print(f"Лучшая модель на тесте: {best['модель']}")
    print(f"  MAE = {best['MAE']:,.0f}  ({best['MAE, % от остатка']:.2%} от среднего остатка)")
    print(f"  против naive: {best['лучше naive']:+.1%}  (MAE naive = {mae_naive:,.0f})")
    print(f"  смещение: {best['смещение (факт − прогноз)']:+,.0f} "
          f"({'прогноз занижен' if best['смещение (факт − прогноз)'] > 0 else 'прогноз завышен'} в среднем)")
    if pd.notna(best["покрытие 5–95%"]):
        print(f"  факт внутри интервала 5–95%: {best['покрытие 5–95%']:.0%} (цель 90%)")
    print(f"Честно выбранная без знания теста: {r['model_for_test']}, "
          f"MAE = {r['MAE_model_test']:,.0f} ({r['skill_test']:+.1%} к naive)")
    show_df(tab, {"MAE": "{:,.0f}", "MAE, % от остатка": "{:.2%}", "смещение (факт − прогноз)": "{:+,.0f}",
                  "макс. ошибка": "{:,.0f}", "покрытие 5–95%": "{:.0%}", "лучше naive": "{:+.1%}"})

    # --- график
    fig, (ax, ax2) = plt.subplots(2, 1, figsize=(12, 7), sharex=True, gridspec_kw={"height_ratios": [3, 1.3]})
    f0 = f0.sort_values("tgt_date")
    if _band(0.05, 0.95):
        ax.fill_between(f0["tgt_date"], f0["q0.05"], f0["q0.95"], color="C0", alpha=.15,
                        label=f"{best['модель']}: 5–95%")
    ax.plot(f0["tgt_date"], f0["bh"], "k", lw=2, label="факт")
    for i, n in enumerate(tab["модель"]):
        f = tp[tp["model"] == n].sort_values("tgt_date")
        is_best = n == best["модель"]
        ax.plot(f["tgt_date"], f["q0.5"], lw=2.2 if is_best else 1, alpha=1 if is_best else .6,
                color="C0" if is_best else f"C{i + 1}", ls="-" if is_best or n == "naive" else "--",
                label=f"{n} (MAE {tab.loc[i, 'MAE']:,.0f})")
        if is_best:
            ax2.bar(f["tgt_date"], f["bh"] - f["q0.5"], color="C0", width=1)
    ax.set_title(f"Тест, горизонт {horizon}M — {group}. Лучшая: {best['модель']}, "
                 f"MAE {best['MAE, % от остатка']:.2%} от остатка, {best['лучше naive']:+.1%} к naive")
    ax.legend(loc="best", fontsize=8); ax.grid(alpha=.3)
    ax2.axhline(0, color="k", lw=.8); ax2.set_ylabel("факт − прогноз"); ax2.grid(alpha=.3)
    ax2.set_xlabel("дата, на которую прогноз"); ax2.tick_params(axis="x", rotation=30)
    plt.tight_layout(); plt.show()

show_test()

# Сводка по всем горизонтам: лучшая модель на тесте и её ошибка
if not test_preds.empty:
    g0 = SHOW_GROUP or test_preds["group"].iloc[0]
    tt = test_preds[test_preds["group"] == g0].assign(ae=lambda d: (d["bh"] - d["q0.5"]).abs())
    summ = tt.groupby(["horizon_m", "model"])["ae"].mean().unstack()
    out = pd.DataFrame({"лучшая на тесте": summ.idxmin(axis=1), "MAE лучшей": summ.min(axis=1),
                        "MAE naive": summ["naive"]})
    out["лучше naive"] = 1 - out["MAE лучшей"] / out["MAE naive"]
    out["MAE, % от остатка"] = out["MAE лучшей"] / tt[tt["model"] == "naive"].groupby("horizon_m")["bh"].apply(
        lambda x: x.abs().mean())
    print(f"\nСводка по горизонтам — {g0}")
    show_df(out, {"MAE лучшей": "{:,.0f}", "MAE naive": "{:,.0f}", "лучше naive": "{:+.1%}",
                  "MAE, % от остатка": "{:.2%}"})
