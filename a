    "rng = np.random.default_rng(2026)\n",
    "DATES = pd.date_range(\"2017-01-01\", \"2025-12-31\", freq=\"D\")\n",
    "n = len(DATES)\n",
    "\n",
    "def balance_path(level0, growth, salary, vol, lump_rate, shocks, slow_from=\"2024-01-01\"):\n",
    "    \"\"\"Дневной путь остатка (в млн) с ростом, зарплатным циклом, шумом, снятиями и шоками.\"\"\"\n",
    "    slow = DATES >= pd.Timestamp(slow_from)\n",
    "    trend = np.cumsum(np.where(slow, growth * 0.2, growth) / 365.25)\n",
    "    annual = 0.02 * np.sin(2 * np.pi * (DATES.dayofyear.values - 100) / 365.25)\n",
    "    dom = DATES.day.values\n",
    "    dim_prev = (DATES - pd.offsets.MonthBegin(1)).days_in_month.values\n",
    "    since = np.where(dom >= 20, dom - 20, np.where(dom >= 5, dom - 5, dom + dim_prev - 20))\n",
    "    cycle = np.where((dom >= 5) & (dom < 20), salary, salary * 0.6) * np.exp(-since / 7)\n",
    "    ar = np.zeros(n); eps = rng.normal(0, vol, n)\n",
    "    for i in range(1, n):\n",
    "        ar[i] = 0.97 * ar[i - 1] + eps[i]\n",
    "    lumps = np.zeros(n)\n",
    "    for i0 in np.where(rng.random(n) < lump_rate)[0]:\n",
    "        k = np.arange(n - i0); lumps[i0:] -= rng.uniform(0.02, 0.05) * np.exp(-k / 40)\n",
    "    sh = np.zeros(n)\n",
    "    for t0, depth, fall, rec in shocks:\n",
    "        i0 = DATES.get_indexer([pd.Timestamp(t0)])[0]; k = np.arange(n - i0)\n",
    "        sh[i0:] += np.where(k <= fall, -depth * k / fall, -depth * np.exp(-(k - fall) / rec))\n",
    "    return level0 * np.exp(trend + annual + cycle + ar + lumps + sh)\n",
    "\n",
    "SHOCKS = [(\"2020-03-16\", 0.06, 20, 90), (\"2022-02-24\", 0.18, 14, 240)]\n",
    "segments = {                                       # (код счёта, валюта): путь остатка в млн ед. валюты\n",
    "    (\"3014_01\", \"BYN\"): balance_path(1500, 0.08, 0.08, 0.005, 1/120, SHOCKS),\n",
    "    (\"3014_02\", \"BYN\"): balance_path(700, 0.08, 0.06, 0.006, 1/150, SHOCKS),\n",
    "    (\"3014_03\", \"BYN\"): balance_path(300, 0.05, 0.03, 0.007, 1/200, SHOCKS),\n",
    "    (\"3014_01\", \"RUB\"): balance_path(900, 0.05, 0.02, 0.008, 1/150, SHOCKS[1:]),\n",
    "    (\"3014_01\", \"USD\"): balance_path(60, 0.03, 0.01, 0.006, 1/200, SHOCKS[1:]),\n",
    "    (\"3012_01\", \"BYN\"): balance_path(4000, 0.06, 0.03, 0.010, 1/40, SHOCKS),\n",
    "    (\"3012_01\", \"RUB\"): balance_path(1200, 0.04, 0.02, 0.012, 1/40, SHOCKS[1:]),\n",
    "}\n",
    "fx = {\"BYN\": np.ones(n), \"RUB\": 0.035 * np.exp(np.cumsum(rng.normal(0, 0.004, n))),\n",
    "      \"USD\": 3.2 * np.exp(np.cumsum(rng.normal(0, 0.002, n)))}\n",
    "\n",
    "raw = pd.concat([pd.DataFrame({\n",
    "    \"REP_DT\": DATES.strftime(\"%d.%m.%Y\"), \"GROU4_OF_COA\": coa, \"ISO_4217_CURY_DESC\": cur,\n",
    "    \"CURRENCY\": fx[cur].round(6), \"OST_VAL\": (path * 1e6).round(2)})\n",
    "    for (coa, cur), path in segments.items()], ignore_index=True)\n",
    "raw[\"OST_NV\"] = (raw[\"OST_VAL\"] * raw[\"CURRENCY\"]).round(2)\n",
    "\n",
    "print(f\"Строк в выгрузке: {len(raw):,}  ({n:,} дней × {len(segments)} групп)\")\n",
    "display(raw.head(8))\n",
    "save(raw.head(5000), \"01_raw_sample\", index=False)     # весь файл большой — сохраняем первые 5000 строк для примера"
