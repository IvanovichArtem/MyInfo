def gap_table(fa, amount):
    a = fa["a"].values
    c = np.minimum.accumulate(np.minimum(a, 0))          # накопленный отток без «возвратов»
    x = np.diff(np.r_[0, c])                             # отток внутри бакета
    out = pd.DataFrame({"бакет": fa["бакет"],
                        "a, %": (a * 100).round(2),
                        "x, %": (x * 100).round(2),
                        "V, млн": (x * amount).round(1),
                        "остаток после, млн": (amount * (1 + c)).round(1)})
    return out

