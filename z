def forecast_a(t0):
    """Для каждого бакета: корзина того же режима, только t + tau <= t0, квантиль p."""
    rows = []
    for k in BUCKETS:
        p, h, kernel = PARAMS[k]
        regime_t0 = regimes.loc[t0, k]
        hist_idx = dd.index[dd.index <= t0 - pd.Timedelta(days=TAU[k])]     # шаг 5: без утечки
        basket = dd.loc[hist_idx, k][regimes.loc[hist_idx, k] == regime_t0].dropna()
        a = np.quantile(basket, 1 - p / 100) if len(basket) else np.nan    # шаг 6
        rows.append({"бакет": f"{k}M", "p": p, "режим t0": regime_t0,
                     "N в корзине": len(basket), "a": a})
    return pd.DataFrame(rows)

