    "## 4. Модели\n",
    "Все модели прогнозируют набор квантилей таргета. Медиана — точечный прогноз.\n",
    "- **naive** — «остаток не изменится», разброс из истории;\n",
    "- **hist_all / hist_recent** — историческая симуляция: квантили прошлых изменений за этот горизонт (за всю историю / за последний год);\n",
    "- **gbm** — градиентный бустинг с квантильной функцией потерь на признаках текущего состояния;\n",
    "- **ens** — среднее квантилей `gbm` и `hist_recent`;\n",
    "- **random_walk** — запасной вариант, когда истории на горизонт не хватает: дневная волатильность × √дней."
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "class NaiveModel:\n",
    "    def fit(self, D):\n",
    "        y = D[\"y\"].to_numpy()\n",
    "        self.q = np.quantile(y, QUANTILES) - np.median(y)\n",
    "        return self\n",
    "    def predict(self, D):\n",
    "        return np.tile(self.q, (len(D), 1))\n",
    "\n",
    "\n",
    "class RandomWalkModel:\n",
    "    \"\"\"Запасной вариант при нехватке истории: разброс = дневная волатильность × √дней.\"\"\"\n",
    "    def __init__(self, s, tr, m):\n",
    "        x = np.log(s) if tr.mode == \"log\" else s / tr.scale\n",
    "        r = x.diff().dropna()\n",
    "        sigma = 1.4826 * (r - r.median()).abs().median() if len(r) > 5 else 0.0\n",
    "        days = ((s.index[-1] + pd.DateOffset(months=m)) - s.index[-1]).days\n",
    "        self.q = np.array([NormalDist().inv_cdf(q) * sigma * np.sqrt(days) for q in QUANTILES])\n",
    "    def predict(self, D):\n",
    "        return np.tile(self.q, (len(D), 1))\n",
    "\n",
    "\n",
    "class HistModel:\n",
    "    def __init__(self, window_days=None):\n",
    "        self.window_days = window_days\n",
    "    def fit(self, D):\n",
    "        if self.window_days:\n",
    "            D = D[D.index > D.index.max() - pd.Timedelta(days=self.window_days)]\n",
    "        self.q = np.quantile(D[\"y\"].to_numpy(), QUANTILES)\n",
    "        return self\n",
    "    def predict(self, D):\n",
    "        return np.tile(self.q, (len(D), 1))\n",
    "\n",
    "\n",
    "def _make_regressor(q):\n",
    "    if HAS_LGB:\n",
    "        return lgb.LGBMRegressor(objective=\"quantile\", alpha=q, n_estimators=400, learning_rate=0.03,\n",
    "                                 num_leaves=15, min_child_samples=40, subsample=0.8, subsample_freq=1,\n",
    "                                 colsample_bytree=0.8, reg_lambda=1.0, random_state=RANDOM_STATE, verbose=-1)\n",
    "    return HistGradientBoostingRegressor(loss=\"quantile\", quantile=q, max_iter=150, learning_rate=0.08,\n",
    "                                         max_leaf_nodes=15, min_samples_leaf=40, l2_regularization=1.0,\n",
    "                                         random_state=RANDOM_STATE)\n",
    "\n",
    "\n",
    "class GBMModel:\n",
    "    def fit(self, D):\n",
    "        self.feats = [c for c in D.columns if c not in META_COLS]\n",
    "        y = D[\"y\"]\n",
    "        lo, hi = np.quantile(y, [WINSOR_Q, 1 - WINSOR_Q])\n",
    "        y = y.clip(lo, hi)\n",
    "        if HALF_LIFE_DAYS:\n",
    "            age = (D.index.max() - D.index).days.to_numpy()\n",
    "            w = 0.5 ** (age / HALF_LIFE_DAYS)\n",
    "        else:\n",
    "            w = np.ones(len(D))\n",
    "        self.models = [_make_regressor(q).fit(D[self.feats], y, sample_weight=w) for q in QUANTILES]\n",
    "        return self\n",
    "    def predict(self, D):\n",
    "        P = np.column_stack([mdl.predict(D[self.feats]) for mdl in self.models])\n",
    "        return np.sort(P, axis=1)  # квантили не пересекаются\n",
    "\n",
    "\n",
    "def make_models(n_train):\n",
    "    models = {\"naive\": NaiveModel(), \"hist_all\": HistModel(), \"hist_recent\": HistModel(RECENT_DAYS)}\n",
    "    if n_train >= MIN_TRAIN_ML:\n",
    "        models[\"gbm\"] = GBMModel()\n",
    "    return models\n",
    "\n",
    "\n",
    "def fit_predict(train, test, only=None):\n",
    "    \"\"\"Обучает модели на train и возвращает квантили для test. Ансамбль собирается из готовых прогнозов.\"\"\"\n",
    "    models = make_models(len(train))\n",
    "    need = set(models) if only is None else ({\"gbm\", \"hist_recent\"} if only == \"ens\" else {only})\n",
    "    P = {n: mdl.fit(train).predict(test) for n, mdl in models.items() if n in need}\n",
    "    if \"gbm\" in P and \"hist_recent\" in P:\n",
    "        P[\"ens\"] = np.sort((P[\"gbm\"] + P[\"hist_recent\"]) / 2, axis=1)\n",
    "    return P if only is None else P[only]"
   ]
