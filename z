    "        marker=\"o\", figsize=(9, 4), title=f\"MAE скользящего бэктеста по горизонтам — {name}\")\n",
    "    ax.set_xlabel(\"горизонт, мес.\"); ax.set_ylabel(\"MAE\"); ax.grid(alpha=.3)\n",
    "    plt.tight_layout(); plt.show()"
