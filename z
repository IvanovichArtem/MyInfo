import holidays
import numpy as np
import pandas as pd


def add_calendar_features(df: pd.DataFrame) -> pd.DataFrame:
    """Возвращает датафрейм с календарными признаками по REP_DT."""
    dates = pd.to_datetime(df["REP_DT"]).dt.tz_localize(None).dt.normalize()
    cal = dates.dt
    iso = cal.isocalendar()
    weekday = cal.dayofweek.astype("Int8")  # Понедельник = 0

    years = cal.year.dropna().astype(int)
    # Соседние годы нужны для поиска ближайшего праздника на границе года.
    holiday_years = range(years.min() - 1, years.max() + 2) if not years.empty else []
    calendar = holidays.country_holidays("RU", years=holiday_years, observed=True)

    holiday_names = {pd.Timestamp(day): name for day, name in calendar.items()}
    holiday_name = dates.map(holiday_names).astype("string")
    holiday_dates = pd.DatetimeIndex(sorted(holiday_names))
    holiday_lookup = pd.Series(holiday_dates, index=holiday_dates)

    previous_holiday = holiday_lookup.reindex(dates, method="ffill").to_numpy()
    next_holiday = holiday_lookup.reindex(dates, method="bfill").to_numpy()
    # В сам праздник оба расстояния равны нулю.
    days_since_holiday = (dates - previous_holiday).dt.days.astype("Int64")
    days_until_holiday = (next_holiday - dates).dt.days.astype("Int64")

    return df.assign(
        year=cal.year,
        quarter=cal.quarter,
        month=cal.month,
        day_of_month=cal.day,
        day_of_year=cal.dayofyear,
        iso_year=iso.year,
        iso_week=iso.week,
        day_of_week=weekday,
        is_weekend=weekday.ge(5),
        is_month_start=cal.is_month_start,
        is_month_end=cal.is_month_end,
        is_quarter_start=cal.is_quarter_start,
        is_quarter_end=cal.is_quarter_end,
        is_year_start=cal.is_year_start,
        is_year_end=cal.is_year_end,
        days_to_month_end=cal.days_in_month - cal.day,
        weekday_sin=np.sin(2 * np.pi * weekday / 7),
        weekday_cos=np.cos(2 * np.pi * weekday / 7),
        month_sin=np.sin(2 * np.pi * (cal.month - 1) / 12),
        month_cos=np.cos(2 * np.pi * (cal.month - 1) / 12),
        is_holiday=holiday_name.notna().astype("boolean").where(dates.notna()),
        holiday_name=holiday_name,
        days_since_holiday=days_since_holiday,
        days_until_holiday=days_until_holiday,
        is_day_before_holiday=days_until_holiday.eq(1),
        is_day_after_holiday=days_since_holiday.eq(1),
    )


df = add_calendar_features(df)
