from pathlib import Path

import pandas as pd

folder = Path(r"D:\путь\к\csv")
dtypes = {"COL_1": "float64", "COL_2": "float64"}

df = pd.concat(
    (pd.read_csv(file, dtype=dtypes) for file in sorted(folder.glob("*.csv"))),
    ignore_index=True,
)
df["REP_DT"] = pd.to_datetime(df["REP_DT"])
