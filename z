    "def prepare_series(d):\n",
    "    \"\"\"Один ряд остатков по календарным дням. Пропуски (выходные) заполняются последним остатком.\"\"\"\n",
    "    d = d[[DATE_COL, VALUE_COL]].copy()\n",
    "    d[DATE_COL] = pd.to_datetime(d[DATE_COL]).dt.normalize()\n",
    "    d[VALUE_COL] = pd.to_numeric(d[VALUE_COL], errors=\"coerce\")\n",
    "    d = d.dropna()\n",
    "    s = d.groupby(DATE_COL)[VALUE_COL].agg(DUPLICATE_AGG).sort_index().astype(float)\n",
    "    observed = s.index\n",
    "    if CLEAN_OUTLIERS and len(s) >= 30:\n",
    "        s = clean_outliers(s)\n",
    "    s = s.reindex(pd.date_range(s.index.min(), s.index.max(), freq=\"D\")).ffill()\n",
    "    s.name = VALUE_COL\n",
    "    return s, observed\n",
    "\n",
    "\n",
    "def clean_outliers(s):\n",
    "    \"\"\"Одиночные выбросы: отклонение от скользящей медианы больше OUTLIER_Z робастных σ.\"\"\"\n",
    "    x = np.log(s) if (s > 0).all() else s\n",
    "    med = x.rolling(15, center=True, min_periods=3).median()\n",
    "    dev = x - med\n",
    "    mad = 1.4826 * dev.abs().rolling(91, center=True, min_periods=15).median()\n",
    "    mad = mad.fillna(1.4826 * dev.abs().median()).replace(0, np.nan).fillna(dev.abs().mean() + 1e-12)\n",
    "    bad = dev.abs() > OUTLIER_Z * mad\n",
    "    if bad.any():\n",
    "        print(f\"  очищено выбросов: {int(bad.sum())} ({', '.join(str(d.date()) for d in s.index[bad][:5])}\"\n",
    "              f\"{' …' if bad.sum() > 5 else ''})\")\n",
    "        x = x.where(~bad, med)\n",
    "        s = np.exp(x) if (s > 0).all() else x\n",
    "    return s\n",
    "\n",
    "\n",
    "class Target:\n",
    "    \"\"\"Таргет = относительное изменение остатка за горизонт.\n",
    "    log-режим (все остатки > 0): y = ln(B_h / B_0).\n",
    "    rel-режим (есть нули/минусы): y = (B_h - B_0) / scale, scale = скользящее среднее |B| за 63 дня.\"\"\"\n",
    "    def __init__(self, s):\n",
    "        self.mode = \"log\" if (s > 0).all() else \"rel\"\n",
    "        sc = s.abs().rolling(63, min_periods=1).mean()\n",
    "        self.scale = sc.clip(lower=max(float(sc.median()) * 1e-3, 1e-9))\n",
    "\n",
    "    def to_target(self, b0, bh, sc):\n",
    "        return np.log(bh / b0) if self.mode == \"log\" else (bh - b0) / sc\n",
    "\n",
    "    def to_level(self, b0, y, sc):\n",
    "        b0, sc = np.asarray(b0, float), np.asarray(sc, float)\n",
    "        y = np.asarray(y, float)\n",
    "        if y.ndim == 2:\n",
    "            b0, sc = b0[:, None], sc[:, None]\n",
    "        return b0 * np.exp(y) if self.mode == \"log\" else b0 + y * sc\n",
    "\n",
    "\n",
    "def make_features(s, tr):\n",
    "    \"\"\"Признаки на дату t используют только информацию до t включительно.\"\"\"\n",
    "    x = np.log(s) if tr.mode == \"log\" else s / s.abs().median()\n",
    "    r = x.diff()\n",
    "    F = pd.DataFrame(index=s.index)\n",
    "    for L in (1, 5, 21, 63, 126, 252):\n",
    "        F[f\"chg_{L}\"] = x - x.shift(L)\n",
    "    for W in (21, 63, 252):\n",
    "        F[f\"vol_{W}\"] = r.rolling(W, min_periods=W // 2).std()\n",
    "    for W in (21, 63, 252):\n",
    "        F[f\"dev_ma_{W}\"] = x - x.rolling(W, min_periods=W // 2).mean()\n",
    "    F[\"dev_max_252\"] = x - x.rolling(252, min_periods=126).max()\n",
    "    F[\"dev_min_252\"] = x - x.rolling(252, min_periods=126).min()\n",
    "    idx = s.index\n",
    "    F[\"dow\"] = idx.dayofweek\n",
    "    F[\"dom\"] = idx.day\n",
    "    F[\"month\"] = idx.month\n",
    "    F[\"days_to_month_end\"] = ((idx + pd.offsets.MonthEnd(0)) - idx).days\n",
    "    return F\n",
    "\n",
    "\n",
    "def build_dataset(s, F, tr, m, origins):\n",
    "    \"\"\"Строка = точка прогноза t; таргет = изменение остатка от t до t + m месяцев.\"\"\"\n",
    "    tgt = s.index + pd.DateOffset(months=m)\n",
    "    D = F.copy()\n",
    "    D[\"tgt_month\"] = tgt.month\n",
    "    D[\"b0\"] = s.to_numpy()\n",
    "    D[\"bh\"] = s.reindex(tgt).to_numpy()\n",
    "    D[\"sc\"] = tr.scale.to_numpy()\n",
    "    D[\"tgt_date\"] = tgt\n",
    "    D[\"y\"] = tr.to_target(D[\"b0\"], D[\"bh\"], D[\"sc\"])\n",
    "    return D.loc[D.index.isin(origins)]\n",
    "\n",
    "META_COLS = [\"b0\", \"bh\", \"sc\", \"tgt_date\", \"y\"]"
   ]
